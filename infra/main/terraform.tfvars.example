# Copiar a terraform.tfvars (gitignored) y completar con valores reales.

github_repo      = "tu-usuario/lab-aws-devops"
alert_email      = "vos@ejemplo.com"
alert_from_email = "alertas@tu-dominio.com"
serpapi_api_key  = "tu-api-key-de-serpapi.com"

# Si el repo usa "immutable subject" para OIDC (default en repos nuevos):
# gh api repos/<owner>/<repo>/actions/oidc/customization/sub  -> sub_claim_prefix
# github_oidc_sub_prefix = "repo:tu-usuario@123/lab-aws-devops@456"

# Opcionales - estos son los defaults:
# aws_region                 = "us-east-1"
# project_name                = "devops-lab"
# scrape_schedule_expression = "rate(4 days)"
# price_drop_check_enabled   = "DISABLED"
# log_retention_days          = 3
